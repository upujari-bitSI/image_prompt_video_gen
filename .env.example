# ── LLM (scene parser) ────────────────────────────────────────────────────
# Provider: anthropic | openai | ollama | local
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Alternatively:
# OPENAI_API_KEY=sk-...

# ── GPU ───────────────────────────────────────────────────────────────────
GPU_DEVICE=cuda
GPU_DTYPE=bf16                # bf16 (RTX 5090 native) | fp16 | fp32
GPU_ENABLE_XFORMERS=true
GPU_ENABLE_VAE_TILING=true
GPU_ENABLE_VAE_SLICING=true
GPU_COMPILE_MODEL=false       # torch.compile — set true for long runs

# ── Diffusion models ──────────────────────────────────────────────────────
DIFFUSION_BASE_MODEL_ID=emilianJR/epiCRealism
DIFFUSION_MOTION_ADAPTER_ID=guoyww/animatediff-motion-adapter-v1-5-3
DIFFUSION_SVD_MODEL_ID=stabilityai/stable-video-diffusion-img2vid-xt
DIFFUSION_NUM_INFERENCE_STEPS=25
DIFFUSION_GUIDANCE_SCALE=7.5
DIFFUSION_IP_ADAPTER_SCALE=0.6

# ── Video defaults ────────────────────────────────────────────────────────
VIDEO_DEFAULT_FPS=24
VIDEO_CRF=18
VIDEO_PRESET=slow

# ── App ───────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=7860
APP_DEBUG=false
